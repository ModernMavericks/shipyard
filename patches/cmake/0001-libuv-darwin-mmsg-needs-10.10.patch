CMake's bundled libuv (Utilities/cmlibuv/src/unix/udp.c) gates its batched-datagram path --
built on Darwin's recvmsg_x/sendmsg_x -- on `(defined(__APPLE__) && (MAC_OS_X_VERSION_MIN_REQUIRED
>= 1070))`, i.e. "Mac OS X 10.7 or newer". That's wrong: recvmsg_x and sendmsg_x are 10.10+ syscalls
(not present in the 10.9 SDK's headers or in a real 10.9 libSystem), so a 10.9-floor build links
bin/cmake and bin/ccmake against symbols the OS doesn't have -- undefined at link time here, and
would be missing at runtime even if a newer SDK let it link.

This patch raises those three MAC_OS_X_VERSION_MIN_REQUIRED gates in udp.c from 1070 to 101000, so
a 10.9-floor build falls back to libuv's existing per-message sendmsg/recvmsg path (correct, just
not batched) instead of trying to call syscalls that don't exist below 10.10. It touches nothing
else: the MAC_OS_X_VERSION_MAX_ALLOWED >= 1070 checks elsewhere in udp.c (lines ~848, ~1062) are a
different condition (whether the *build* toolchain's headers declare MSG_WAITFORONE-adjacent bits)
and are left alone. arm64/11.0 shipyard-cmake builds are unaffected -- their deployment target is
already above 10.10, so they keep the batched recvmsg_x/sendmsg_x path.

Filed upstream with Kitware/libuv as a real deployment-target bug; not yet acknowledged as of this
writing, so shipyard carries the fix locally until then.

Usage: from the top of an extracted cmake-4.4.3/ source tree, `patch -p1 < this file`.

--- a/Utilities/cmlibuv/src/unix/udp.c
+++ b/Utilities/cmlibuv/src/unix/udp.c
@@ -195,7 +195,7 @@

 static int uv__udp_recvmmsg(uv_udp_t* handle, uv_buf_t* buf, int flag) {
 #if defined(__linux__) || defined(__FreeBSD__) || \
-   (defined(__APPLE__) && (MAC_OS_X_VERSION_MIN_REQUIRED >= 1070))
+   (defined(__APPLE__) && (MAC_OS_X_VERSION_MIN_REQUIRED >= 101000))
   struct sockaddr_in6 peers[20];
   struct iovec iov[ARRAY_SIZE(peers)];
   struct mmsghdr msgs[ARRAY_SIZE(peers)];
@@ -971,7 +971,7 @@

 int uv_udp_using_recvmmsg(const uv_udp_t* handle) {
 #if defined(__linux__) || defined(__FreeBSD__) || \
-   (defined(__APPLE__) && (MAC_OS_X_VERSION_MIN_REQUIRED >= 1070))
+   (defined(__APPLE__) && (MAC_OS_X_VERSION_MIN_REQUIRED >= 101000))
   if (handle->flags & UV_HANDLE_UDP_RECVMMSG)
     return 1;
 #endif
@@ -1415,7 +1415,7 @@
   nsent = 0;

 #if defined(__linux__) || defined(__FreeBSD__) || \
-  (defined(__APPLE__) && (MAC_OS_X_VERSION_MIN_REQUIRED >= 1070)) || \
+  (defined(__APPLE__) && (MAC_OS_X_VERSION_MIN_REQUIRED >= 101000)) || \
   (defined(__sun__) && defined(MSG_WAITFORONE)) || defined(__QNX__)
   if (count > 1) {
     for (i = 0; i < count; /*empty*/) {
